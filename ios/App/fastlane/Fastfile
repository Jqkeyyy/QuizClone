default_platform(:ios)

platform :ios do
  desc "Sign with an App Store Connect API key, build, and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
    )

    # Temporary keychain on the CI runner.
    setup_ci

    # Reuse the one distribution certificate stored in GitHub secrets
    # instead of creating a new one on every run.
    import_certificate(
      certificate_path: ENV["DIST_CERT_PATH"],
      certificate_password: ENV["DIST_CERT_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )
    get_provisioning_profile(api_key: api_key, app_identifier: "com.jqkeyyy.flashcards")

    # Xcode 16+ reads profiles from UserData, not MobileDevice.
    xcode_profiles = File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
    FileUtils.mkdir_p(xcode_profiles)
    FileUtils.cp(
      lane_context[SharedValues::SIGH_PROFILE_PATH],
      File.join(xcode_profiles, "#{lane_context[SharedValues::SIGH_UUID]}.mobileprovision"),
    )

    # Diagnostics: which profiles Xcode can see and what this one contains.
    sh("ls -la ~/Library/MobileDevice/Provisioning\ Profiles ~/Library/Developer/Xcode/UserData/Provisioning\ Profiles || true")
    sh("security cms -D -i '#{lane_context[SharedValues::SIGH_PROFILE_PATH]}' | plutil -extract Name raw -o - - ; security cms -D -i '#{lane_context[SharedValues::SIGH_PROFILE_PATH]}' | plutil -extract Platform json -o - -")
    sh("security find-identity -v -p codesigning")

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "iPhone Distribution",
      profile_uuid: lane_context[SharedValues::SIGH_UUID],
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

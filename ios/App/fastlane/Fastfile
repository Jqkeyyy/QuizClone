default_platform(:ios)

platform :ios do
  desc "Sign with an App Store Connect API key, build, and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"],
    )

    # Temporary keychain on the CI runner.
    setup_ci

    # Creates a distribution certificate and App Store profile if needed.
    get_certificates(api_key: api_key)
    get_provisioning_profile(api_key: api_key, app_identifier: "com.jqkeyyy.flashcards")

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']}",
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
